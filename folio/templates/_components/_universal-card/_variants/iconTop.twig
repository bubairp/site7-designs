{#- Folio: Universal Card "Icon Top" (overrides the Theme's _variants/iconTop.twig; same
	output). The only change: a photo (not an SVG icon) is requested at 800px instead of the
	icon size, so the capability grid's feature tiles (folio.css .folio-capabilities) are
	sharp. SVG icons keep the icon size and the colour mask. -#}
{% import "_macros/images" as images %}
{% set iconAsset = itemData.image|length ? itemData.image.0 : null %}
{% set isPhoto = iconAsset and (iconAsset.extension|lower) != 'svg' %}

<div class="p-4 flex-auto last-0">
	{% if iconAsset %}
		<div class="block {{ ('center' in mappedAlign) ? 'mx-auto' : (('right' in mappedAlign or 'end' in mappedAlign) ? 'ms-auto me-0' : 'ms-0 me-auto') }} mb-4" style="width: {{ iconSizeValue }}px;"><div class="aspect-square" {{ images.iconMask(iconAsset) }}>{{ images.singleImg(iconAsset, isPhoto ? 800 : iconSizeValue, {'ratio': 1}, 'shrink-0 w-full h-full object-contain') }}</div></div>
	{% endif %}
	<h3 class="{{ titleSizeClass }} universalCard-title tw-service-heading-title mb-2">{{ itemData.title }}</h3>
	{% if itemData.description|length %}
		<div class=" universalCard-content tw-service-content-style last-0">{{ itemData.description }}</div>
	{% endif %}

	{% if showButton %}
		<div class="mt-3">
			<div class="tw-btn {{ colorPalette }} after:absolute after:inset-0 after:z-10 after:content-['']">{{ itemData.linkText }}</div>
		</div>
	{% endif %}
</div>
