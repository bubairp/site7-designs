{#- Altitude: the slide's check list (overrides templates/_includes/hero-banner/_list.twig).
	"figure | label" on every item makes a stats row: a slim translucent bar: figures over
	small labels, split by hairlines; anything else is a list with quiet ticks (an item's icon replaces
	the tick). Expects: items (check list rows). -#}
{% if items|length %}
	{% set isStats = items|filter(i => '|' in (i.title ?? ''))|length == items|length %}
	{% if isStats %}
		{% set cols = { 1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3' }[items|length] ?? 'md:grid-cols-4' %}
		<ul class="hero-stats mx-auto m-0 grid max-w-4xl list-none grid-cols-2 gap-y-3 rounded-xl border border-white/10 bg-surface-dark/70 px-4 py-4 backdrop-blur-md md:px-2 {{ cols }}">
			{% for stat in items %}
				{% set parts = stat.title|split('|') %}
				<li class="hero-stat flex flex-col items-center gap-0.5 border-white/10 px-2 text-center md:border-l md:first:border-l-0">
					<span class="text-[clamp(1.25rem,2vw,1.6rem)] leading-tight font-[450] text-on-dark">{{ parts[0]|trim }}</span>
					<span class="text-[13px] text-on-dark/65">{{ parts|slice(1)|join('|')|trim }}</span>
				</li>
			{% endfor %}
		</ul>
	{% else %}
		<ul class="check-list hero-check-list m-0 mt-8 flex list-none flex-wrap justify-center gap-x-6 gap-y-3 p-0 text-[15px] text-on-dark/80">
			{% for item in items %}
				<li class="flex items-center gap-2">
					<i class="{{ (item.iconClass ?? false) ? item.iconClass|icon : 'ti ti-check' }} text-base text-on-dark/60" aria-hidden="true"></i>
					{{ item.title }}
				</li>
			{% endfor %}
		</ul>
	{% endif %}
{% endif %}
