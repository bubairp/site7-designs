{#- Harbor: hero layout 3 (overrides templates/_includes/hero-banner/sliderLayout3.twig).
	Editorial puts the copy over a full-bleed photo; Harbor makes it a product stage: a
	graphite band with a blue glow, the copy centred, the slide's image or video in a
	large rounded frame below it, and the stats or check list under the frame.
	Same fields, slides and autoplay as the default. -#}
{% set multi = heroBannerSliders|length > 1 %}
<section class="hero-layout is-dark relative w-full overflow-hidden bg-surface-dark bg-[radial-gradient(55%_45%_at_50%_0%,rgba(33,66,231,0.5),transparent_70%),radial-gradient(35%_35%_at_100%_100%,rgba(33,66,231,0.2),transparent_70%)]" data-theme="dark">
	<div class="{{ multi ? 'swiper' : '' }}" {% if multi %}data-swiper-options='{"effect": "fade","fadeEffect": {"crossFade": true},"speed": 900,"autoplay": {"delay": 7000,"disableOnInteraction": false},"pagination": {"el": ".swiper-pagination","clickable": true}}'{% endif %}>
		<div class="{{ multi ? 'swiper-wrapper' : '' }}">
			{% for slide in heroBannerSliders %}
				{% set bgColor = (slide.colorLibrary.one().colorcode ?? null)|roleColor %}
				{% set hasMedia = slide.imageVideo|length or slide.bgImageVideoMobile|length %}
				{% set items = (slide.displayCheckList ?? false) ? (slide.checkListShowTable ?? []) : [] %}
				<div class="{{ multi ? 'swiper-slide' : '' }} pt-[calc(var(--header-height,96px)+3.5rem)] pb-16 lg:pb-24" {% if bgColor %}style="background-color: {{ bgColor }};"{% endif %}>
					<div class="container mx-auto px-4">
						<div class="mx-auto max-w-4xl text-center">
							{% include "_includes/hero-banner/_copy" with { headingTag: loop.first ? 'h1' : 'h2', withList: false, align: 'center' } %}
						</div>
						{% if hasMedia %}
							<div class="relative mx-auto mt-14 aspect-[4/3] max-w-6xl overflow-hidden rounded-[var(--radius-card-lg)] border border-white/10 shadow-[0_40px_120px_-24px_rgba(0,0,0,0.65)] md:aspect-[16/8]">
								{% include "_includes/hero-banner/_media-pair" with { width: 1600, eager: loop.first } %}
							</div>
						{% endif %}
						{% if items|length %}
							<div class="mx-auto mt-10 max-w-4xl">{% include "_includes/hero-banner/_list" with { items: items, center: true } %}</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
		{% if multi %}<div class="swiper-pagination swiper-pagination-overlay hero-pagination"></div>{% endif %}
	</div>
</section>
